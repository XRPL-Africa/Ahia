# ============================================
# Ahia Backend Environment Configuration
# ============================================

# Server Configuration
NODE_ENV=development
PORT=5000
API_VERSION=v1

# Database Configuration (PostgreSQL)
DATABASE_URL="postgresql://postgres:1111111111@localhost:5432/ahia_db?schema=public"

# Redis Configuration
REDIS_URL="redis://localhost:6379"
REDIS_PASSWORD=""

# JWT Configuration
JWT_SECRET=""
JWT_REFRESH_SECRET="your-refresh-secret-key-change-this-in-production"
JWT_EXPIRES_IN="24h"
JWT_REFRESH_EXPIRES_IN="7d"

# Cloudinary Configuration (File Uploads)
CLOUDINARY_CLOUD_NAME="your-cloudinary-cloud-name"
CLOUDINARY_API_KEY="your-cloudinary-api-key"
CLOUDINARY_API_SECRET="your-cloudinary-api-secret"

# XRPL Configuration
XRPL_NETWORK="testnet"
XRPL_NODE_URL="wss://s.altnet.rippletest.net:51233"
XRPL_PLATFORM_ADDRESS="rYourPlatformWalletAddress"
XRPL_PLATFORM_SEED="sYourPlatformWalletSeed"

# RLUSD Issuer (Testnet/Mainnet)
RLUSD_ISSUER="rQhWct2fv4E4bR7YBQNv4rBc7E4d7c8w"

# Paystack Configuration (Fiat Payments)
PAYSTACK_SECRET_KEY="sk_test_your_paystack_secret_key"
PAYSTACK_PUBLIC_KEY="pk_test_your_paystack_public_key"

# Platform Configuration
PLATFORM_FEE_PERCENTAGE=2.5
ESCROW_DURATION_DAYS=14
ESCROW_EXTENSION_DAYS=7
MAX_ESCROW_EXTENSIONS=1

# Admin Configuration
ADMIN_EMAIL="admin@ahia.app"
ADMIN_PASSWORD_HASH=""

# Email Configuration (Optional - for notifications)
SMTP_HOST="smtp.gmail.com"
SMTP_PORT=587
SMTP_USER="your-email@gmail.com"
SMTP_PASS="your-app-password"

# Logging
LOG_LEVEL="debug"
LOG_FILE="logs/app.log"

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# File Upload Configuration
MAX_FILE_SIZE=5242880
ALLOWED_FILE_TYPES="image/jpeg,image/png,image/webp"
UPLOAD_FOLDER="uploads"

# Security
BCRYPT_ROUNDS=12
CORS_ORIGIN="http://localhost:3000,http://localhost:8081"



